# ─────────────────────────────────────────────────────────────────────────────
# GFA — greenfreightacademy.co.za
# Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file to .env.local  →  cp .env.local.example .env.local
#   2. Fill in every value marked REPLACE_ME
#   3. NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Shared project for the full TAG ecosystem (TAG + GFA + BD)
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://khzctzixeghppwwnzsdq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_your_supabase_service_role_key

# ── Admin Authentication ───────────────────────────────────────────────────────
# A long random string used to sign admin session JWTs.
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=REPLACE_ME_run_openssl_rand_-hex_32
JWT_SECRET=REPLACE_ME_same_value_as_ADMIN_JWT_SECRET
# Alias used in some routes — set to the same value as ADMIN_JWT_SECRET
GFA_JWT_SECRET=REPLACE_ME_same_value_as_ADMIN_JWT_SECRET

# ── WhatsApp (Meta Graph API) ──────────────────────────────────────────────────
# Found in: Meta Developer Portal → Your App → WhatsApp → API Setup
# NOTE: Both variable names are used in the codebase — set both to the same values
WHATSAPP_ACCESS_TOKEN=REPLACE_ME_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME_meta_phone_number_id
META_WA_TOKEN=REPLACE_ME_same_as_WHATSAPP_ACCESS_TOKEN
META_WA_PHONE_NUMBER_ID=REPLACE_ME_same_as_WHATSAPP_PHONE_NUMBER_ID
META_WA_API_VERSION=v19.0

# ── Paystack (Payments) ────────────────────────────────────────────────────────
# Found in: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=REPLACE_ME_sk_live_your_paystack_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=REPLACE_ME_pk_live_your_paystack_key

# ── Bunny.net (Video CDN — Video Library) ─────────────────────────────────────
# Found in: Bunny.net Dashboard → Stream → Library → API
# Required for the GFA Video Library (admin video upload and management)
BUNNY_API_KEY=REPLACE_ME_bunny_api_key
BUNNY_LIBRARY_ID=REPLACE_ME_bunny_library_id
# Alias used in some routes — set to the same value as BUNNY_LIBRARY_ID
BUNNY_STREAM_LIBRARY_ID=REPLACE_ME_same_as_BUNNY_LIBRARY_ID
BUNNY_CDN_HOSTNAME=REPLACE_ME_vz-xxxxxx.b-cdn.net

# ── Resend (Transactional Email) ───────────────────────────────────────────────
# Found in: https://resend.com/api-keys
RESEND_API_KEY=REPLACE_ME_re_your_resend_key

# ── Site URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.greenfreightacademy.co.za
NEXT_PUBLIC_GFA_URL=https://www.greenfreightacademy.co.za
NEXT_PUBLIC_GFA_LOGO_URL=https://www.greenfreightacademy.co.za/logo.png
NEXT_PUBLIC_BD_URL=https://betterdriver.co.za
NEXT_PUBLIC_BETTERDRIVER_URL=https://betterdriver.co.za
NEXT_PUBLIC_TAG_URL=https://www.transportactiongroup.com
NEXT_PUBLIC_ZERO_AFRICA_URL=https://www.zeroafrica.org

# ── BetterDriver integration (server-side) ────────────────────────────────────
# Used by the deploy route to generate BD magic link tokens
BD_BASE_URL=https://betterdriver.co.za
BETTERDRIVER_URL=https://betterdriver.co.za

# ── Port ───────────────────────────────────────────────────────────────────────
PORT=3001
